{
  "name": "act-on-issues",
  "version": "3.0.0",
  "private": true,
  "description": "Act On Issues - civic issue reporting platform (React SPA + Express JSON API)",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "nodemon server.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "seed": "node scripts/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/checkImports.js",
    "prebuild": "node scripts/checkImports.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google-cloud/storage": "^7.11.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "compression": "^1.8.1",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "geoip-lite": "^2.0.3",
    "google-auth-library": "^10.9.0",
    "gsap": "^3.15.0",
    "helmet": "^7.1.0",
    "jimp": "^1.6.1",
    "leaflet": "^1.9.4",
    "mongoose": "^8.5.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "sanitize-html": "^2.17.7",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "jsdom": "^25.0.1",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2",
    "vite": "^5.3.4",
    "vitest": "^3.2.7"
  }
}
