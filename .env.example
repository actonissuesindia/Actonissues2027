# ---- Core ----
NODE_ENV=development
PORT=3001
MONGO_URI=mongodb://localhost:27017/actonissue
SESSION_SECRET=change_this_secret

# Comma-separated list of allowed origins for CORS in development.
# In production the API and SPA are same-origin, so this is only needed for dev.
CLIENT_ORIGIN=http://localhost:5173

# Full public URL of the site (no trailing slash) — used to build clickable
# links inside notification emails. Set to your real domain in production,
# e.g. https://actonissues.com.
SITE_URL=http://localhost:5173

# ---- Email (nodemailer / SMTP) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user
SMTP_PASS=password
SMTP_FROM=no-reply@example.com

# ---- Google Cloud Storage (optional file uploads) ----
# Leave GCS_BUCKET empty to use local disk storage in /uploads instead.
GCS_PROJECT_ID=your-project-id
GCS_BUCKET=
GCS_KEY_FILE=./service-account.json

# ---- Firebase Admin (verifies phone OTP sign-ins server-side) ----
# Get FIREBASE_PROJECT_ID from Firebase Console -> Project settings -> General.
# FIREBASE_SERVICE_ACCOUNT_KEY_FILE = path to a service account key JSON
# downloaded from Project settings -> Service accounts -> Generate new
# private key. Leave blank in production (Cloud Run uses its own service
# account identity instead — see docs/DEPLOYMENT.md).
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_KEY_FILE=

# ---- Web Push (browser/phone push notifications) ----
# Generate a pair with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Leave blank to disable push — in-app notifications still work without these.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@example.com

# ---- WhatsApp (Meta WhatsApp Business Cloud API) ----
# Get WHATSAPP_PHONE_NUMBER_ID and WHATSAPP_ACCESS_TOKEN from
# developers.facebook.com -> your app -> WhatsApp -> API Setup (see
# docs/DEPLOYMENT.md for the full walkthrough, including the message
# template that must be approved before this will actually send).
# Leave WHATSAPP_ACCESS_TOKEN blank to disable WhatsApp notifications — the
# bell icon, push, and email notifications still work without it.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=issue_update

# ---- Inbound email (Brevo inbound parsing — authority reply capture) ----
# See docs/DEPLOYMENT.md Step 17. WEBHOOK_INBOUND_SECRET is a random string
# you make up (put it in the webhook URL you give Brevo); leaving it blank
# disables the webhook (every call gets rejected with 403).
WEBHOOK_INBOUND_SECRET=
INBOUND_REPLY_DOMAIN=reply.actonissues.com

# ---- Auto-translation (Google Cloud Translation API) ----
# See docs/DEPLOYMENT.md Step 18. Auto-translates Articles and Page Builder
# content (Home/About/Founder page text) into the site's 7 non-English
# languages the moment they're published/saved. Leaving this blank just
# disables auto-translation — English-authored content, and the separately
# hand-translated UI text (buttons/menus), are both unaffected either way.
GOOGLE_TRANSLATE_API_KEY=

# ---- Address autocomplete (Geoapify) ----
# See docs/DEPLOYMENT.md Step 20. Powers the address search box and "Use my
# location" lookup on the Raise an Issue form. Get a free key (no card
# needed) at myprojects.geoapify.com. Leaving this blank just means the
# address box won't show suggestions — typing/submitting still works.
VITE_GEOAPIFY_API_KEY=

# ---- Feed search precision (Google Places) ----
# See docs/DEPLOYMENT.md Step 21. Powers the location search box on the Feed
# page — picking a suggestion filters issues by actual distance from that
# point instead of just matching address text. Needs a Google Cloud project
# with billing enabled (a monthly free credit covers low traffic) and the
# "Places API" + "Maps JavaScript API" enabled. Leaving this blank just means
# the Feed location box won't show suggestions.
VITE_GOOGLE_PLACES_API_KEY=

# ---- Analytics / tag manager (optional) ----
# See docs/SEO.md for step-by-step instructions to create each of these.
# Leaving any of them blank just skips that one script — no broken tags,
# no console errors, nothing to disable elsewhere.
# VITE_GTM_ID: Google Tag Manager container ID, looks like GTM-XXXXXXX.
# VITE_GA_ID: Google Analytics 4 measurement ID, looks like G-XXXXXXXXXX.
#   Only needed if you're not already sending GA4 through GTM above — most
#   setups pick one or the other, not both.
# VITE_CLARITY_ID: Microsoft Clarity project ID (Clarity dashboard -> Setup).
VITE_GTM_ID=
VITE_GA_ID=
VITE_CLARITY_ID=

# ---- asset-gen skill (.claude/skills/asset-gen) — optional, game-art generation ----
# Not used by the Act On Issues app itself. Only needed if you run the
# asset-gen skill's Python tools. Each is a separate paid service — get keys
# from aistudio.google.com/apikey (Gemini), console.x.ai (Grok), and
# platform.tripo3d.ai (Tripo3D). Never paste real key values into chat.
GEMINI_API_KEY=
XAI_API_KEY=
TRIPO3D_API_KEY=
